# Theme
theme = "Dracula"
background-opacity = 0.9
background-blur = true

font-family = "Maple Mono NF CN"
font-synthetic-style = false
font-size = 16

# Window
window-height = 45
window-width = 180
window-position-x = 180
window-position-y = 180
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
window-save-state = never
window-new-tab-position = current

# Cursor
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# Quick Terminal
quick-terminal-position = center
quick-terminal-animation-duration = 0

# Misc
confirm-close-surface = false
macos-option-as-alt = true
macos-icon = xray
macos-titlebar-style = tabs
clipboard-paste-protection = false
clipboard-paste-bracketed-safe = true
quick-terminal-size = 70%,70%
quick-terminal-position = center
auto-update-channel = tip

# Keybindings
# keybind = clear
keybind = super+n=new_window
keybind = super+q=quit
keybind = super+w=close_surface
keybind = super+shift+w=close_window
keybind = super+shift+f=toggle_fullscreen

keybind = super+shift+j=move_tab:-1
keybind = super+shift+k=move_tab:1

keybind = super+d=new_split:right

keybind = ctrl+m=text:\x0d
